// Control Flow Patterns Example
// Demonstrates: labels, goto, if-goto, nested conditions, loops

// Function: Simple conditional execution
function simple_conditional 0
    // If argument > 10, return 100, else return 50
    push argument 0
    push constant 10
    gt
    if-goto LARGE_VALUE
    
    // Small value case
    push constant 50
    return
    
    label LARGE_VALUE
    push constant 100
    return

// Function: Nested conditional logic
function nested_conditional 0
    // Multi-level conditional:
    // if x > 20 then return 3
    // else if x > 10 then return 2  
    // else if x > 0 then return 1
    // else return 0
    
    push argument 0
    push constant 20
    gt
    if-goto LEVEL_3
    
    push argument 0
    push constant 10
    gt
    if-goto LEVEL_2
    
    push argument 0
    push constant 0
    gt
    if-goto LEVEL_1
    
    // Level 0: x <= 0
    push constant 0
    return
    
    label LEVEL_1
    push constant 1
    return
    
    label LEVEL_2
    push constant 2
    return
    
    label LEVEL_3
    push constant 3
    return

// Function: Loop with early exit
function loop_with_exit 2
    // Count from 0 to n-1, but exit early if sum > 50
    // locals: counter, sum
    
    push constant 0
    pop local 0        // counter = 0
    push constant 0
    pop local 1        // sum = 0
    
    label LOOP_START
    // Check if counter >= n
    push local 0       // counter
    push argument 0    // n
    eq                 // counter == n?
    if-goto LOOP_END
    
    // Check early exit condition
    push local 1       // sum
    push constant 50   // 50
    gt                 // sum > 50?
    if-goto EARLY_EXIT
    
    // Loop body: sum += counter
    push local 1       // sum
    push local 0       // counter
    add                // sum + counter
    pop local 1        // sum = sum + counter
    
    // Increment counter
    push local 0       // counter
    push constant 1    // 1
    add                // counter + 1
    pop local 0        // counter = counter + 1
    
    goto LOOP_START
    
    label EARLY_EXIT
    // Return negative sum to indicate early exit
    push local 1       // sum
    neg                // -sum
    return
    
    label LOOP_END
    push local 1       // return final sum
    return

// Function: Switch-like pattern using goto
function switch_pattern 0
    // Simulate switch statement using labels and goto
    // Cases: 1->10, 2->20, 3->30, default->0
    
    push argument 0
    push constant 1
    eq
    if-goto CASE_1
    
    push argument 0
    push constant 2
    eq
    if-goto CASE_2
    
    push argument 0
    push constant 3
    eq
    if-goto CASE_3
    
    // Default case
    push constant 0
    goto END_SWITCH
    
    label CASE_1
    push constant 10
    goto END_SWITCH
    
    label CASE_2
    push constant 20
    goto END_SWITCH
    
    label CASE_3
    push constant 30
    goto END_SWITCH
    
    label END_SWITCH
    return

// Main program: Test all control flow patterns

// Test 1: Simple conditional with 15 (should return 100)
push constant 15
call simple_conditional 1

// Test 2: Simple conditional with 5 (should return 50)
push constant 5
call simple_conditional 1

// Test 3: Nested conditional with 25 (should return 3)
push constant 25
call nested_conditional 1

// Test 4: Nested conditional with 15 (should return 2)
push constant 15
call nested_conditional 1

// Test 5: Loop with exit, n=20 (should exit early with negative sum)
push constant 20
call loop_with_exit 1

// Test 6: Switch pattern with case 2 (should return 20)
push constant 2
call switch_pattern 1

// Results should be: [100, 50, 3, 2, negative_value, 20]